# Cargo build output (the release binary is rebuilt with `cargo build --release`)
/target/

# Cargo.lock is committed on purpose: this is a binary crate, so the lock file
# pins the exact dependency versions the shipped executable was built with.

# Rust backup files left behind by rustfmt
**/*.rs.bk

# Windows debugging symbols
*.pdb

# Editor and IDE state
.vscode/
.idea/
*.swp
*.swo
*~

# OS clutter
Thumbs.db
Desktop.ini
.DS_Store

# Local scratch and logs
*.log
*.tmp
